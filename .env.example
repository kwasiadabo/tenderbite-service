# ─────────────────────────────────────────────
#  Tenderbite Service – Environment Variables
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
API_VERSION=v1

# MSSQL Database
DB_HOST=localhost
DB_PORT=1433
DB_NAME=TenderbiteDB
DB_USER=sa
DB_PASSWORD=YourStrongPassword!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# CORS – comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger UI
# Auto-enabled in development. Set to true to enable in production.
SWAGGER_ENABLED=false
